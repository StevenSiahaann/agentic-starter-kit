# ==============================================================================
# Production-Grade Multi-Stage Distroless Dockerfile
# Implements: Multi-stage build, minimal footprint (<150MB), non-root user, native Node healthcheck
# ==============================================================================

# STAGE 1: Dependency Installation & TypeScript Compilation
FROM node:20-alpine AS builder

WORKDIR /app

# Enable and activate pnpm via corepack
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy dependency manifests for deterministic layer caching
COPY package.json pnpm-lock.yaml* ./

# Install all dependencies (including devDependencies for compilation)
RUN pnpm install --frozen-lockfile

# Copy application source code
COPY . .

# Compile TypeScript to production JavaScript
RUN pnpm run build

# Prune devDependencies so only production packages remain
RUN pnpm prune --prod

# ==============================================================================
# STAGE 2: Hardened Production Distroless Runner
FROM gcr.io/distroless/nodejs20-debian12:nonroot AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy compiled build artifacts and production node_modules from builder stage
COPY --from=builder --chown=nonroot:nonroot /app/node_modules ./node_modules
COPY --from=builder --chown=nonroot:nonroot /app/dist ./dist
COPY --from=builder --chown=nonroot:nonroot /app/package.json ./package.json

# Execute strictly as unprivileged non-root user
USER nonroot:nonroot

EXPOSE 3000

# Native Node.js Liveness Healthcheck (Distroless contains no shell/curl/wget binaries)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/livez').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["dist/main.js"]
